# Optional; the Access Data Service does not require a CDO token.
NOAA_CDO_TOKEN=
EIA_API_KEY=
NWS_USER_AGENT=(PowerOutageModel, data-team@example.com)

# Optional verified sub-BA forecast input; see docs/data-pipeline.md
EIA_SUBBA_FORECAST_CSV=
# Global concurrent byte ranges (1-32); up to four yearly files prefetched
EAGLE_RANGE_WORKERS=8
